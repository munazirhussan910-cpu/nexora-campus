# ==========================================
# Nexora Campus Backend - Local Environment Variables
# ==========================================
# Copy this file to .env:
# cp .env.example .env

# SQLite local database connection (zero-setup)
DATABASE_URL="file:./nexora.db"

# Express server port
PORT=5001

# JSON Web Token secret for authentication
JWT_SECRET="nexora-campus-secret-key-2026-bput-hackathon"

# Backend application URL
APP_URL="http://localhost:5001"

# Frontend application URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Local directory for generated PDFs and uploads
STORAGE_DIR="./uploads"

# Runtime environment (development | production)
NODE_ENV="development"
