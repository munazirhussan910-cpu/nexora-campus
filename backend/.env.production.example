# Production PostgreSQL Database URL (Neon / Supabase)
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require"

# Server Port (Render sets this automatically, default 5001)
PORT=5001

# Cryptographically secure random 32+ character string
JWT_SECRET="generate-a-secure-random-32-character-secret-key-here"

# Public URL of the Backend API on Render
APP_URL="https://nexora-campus-backend.onrender.com"

# Public URL of the Frontend on Vercel (Required for CORS credentials)
FRONTEND_URL="https://nexora-campus-frontend.vercel.app"

# Ephemeral uploads directory for generated PDFs
STORAGE_DIR="/tmp/uploads"

# Runtime Environment
NODE_ENV="production"
